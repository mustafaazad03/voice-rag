# generated artefacts. data/index is the exception: the CI eval gate re-runs the
# benchmarks against it, so the committed index is what the numbers refer to.
# Largest file is 18 MB, comfortably under GitHub's 100 MB limit — no LFS needed.
data/*
!data/index/
!data/corpus/
data/index/*.bak
data/corpus*.bak
models/

