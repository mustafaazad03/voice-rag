# ---------------------------------------------------------------------------
# Speech-to-text. Provider order is derived from which keys are present:
#   SARVAM_API_KEY only      -> Sarvam
#   ELEVENLABS_API_KEY only  -> ElevenLabs
#   both                     -> Sarvam first, ElevenLabs as automatic fallback
#   neither                  -> text endpoints work, voice endpoints return 503
# ---------------------------------------------------------------------------
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# Sarvam options (docs.sarvam.ai)
SARVAM_MODEL=saaras:v3
SARVAM_MODE=transcribe
SARVAM_LANGUAGE_CODE=unknown

# ElevenLabs options
ELEVENLABS_MODEL=scribe_v1

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
EMBED_REPO=intfloat/multilingual-e5-small
CHUNK_STRATEGY=hierarchical
FUSION=rrf
RERANK=features
FINAL_TOP_K=5

# ---------------------------------------------------------------------------
# Generation. "extractive" is the default and the only one inside the 200 ms
# budget. "llm" needs an OpenAI-compatible endpoint and costs 300 ms - 2 s.
# ---------------------------------------------------------------------------
GENERATOR=extractive
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Budget and thresholds. Similarity thresholds are calibrated for the default
# encoder — re-run `vrag eval-guardrails` after changing EMBED_REPO.
# ---------------------------------------------------------------------------
BUDGET_TOTAL_MS=200
OFF_TOPIC_SIMILARITY=0.80
MIN_RETRIEVAL_SCORE=0.84
MIN_ANSWER_GROUNDING=0.42

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MIN=60
LOG_LEVEL=INFO
LOG_JSON=true
